# 统一按文本处理，检出时用 LF（避免 Windows/Linux 混用时整仓 diff）
* text=auto eol=lf

# Windows 脚本保持 CRLF，Shell 脚本保持 LF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf

# 二进制文件：不做换行转换，也不要在 diff 里显示
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.docx binary
*.xlsx binary
*.pptx binary
*.pdf  binary
*.pt   binary
*.pth  binary
*.npz  binary
